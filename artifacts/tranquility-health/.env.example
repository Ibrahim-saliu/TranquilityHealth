# .env.example — Environment variable template for Tranquility Health.
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
#
# HIPAA NOTE: This file must never contain real credentials, PHI, or secrets.
#   All sensitive values must be provided via environment variables only.

# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In Replit, this is automatically provided when a database is provisioned.
DATABASE_URL="postgresql://user:password@localhost:5432/tranquility_health"

# ==============================================================================
# APPLICATION
# ==============================================================================

# Node environment. Use "development" locally, "production" in deployment.
NODE_ENV="development"

# The port the API server listens on.
# In Replit, PORT is automatically assigned.
PORT="3001"

# ==============================================================================
# AUTH
# ==============================================================================

# Session secret — signs the session cookie. REQUIRED in production; the API
# server refuses to start without it when NODE_ENV=production. Generate a strong
# random value, e.g. `openssl rand -base64 64`.
SESSION_SECRET=""

# Cross-site cookies. If the SPA and the API are served from DIFFERENT origins
# (e.g. two separate Replit URLs), the browser will not send a SameSite=lax/strict
# session cookie on API calls. Set this to "none" so the cookie crosses origins.
# "none" forces the Secure flag, which needs the API behind an HTTPS proxy
# (auto-detected on Replit via REPL_ID). Leave as "lax" when app + API share one
# origin. Values: lax | strict | none
SESSION_COOKIE_SAMESITE="lax"

# CORS allowlist — comma-separated origins allowed to make credentialed requests.
# STRONGLY recommended once SESSION_COOKIE_SAMESITE=none (otherwise any site can
# send the session cookie). Set to the exact origin the app is loaded from, e.g.
# CORS_ORIGINS="https://your-app.riker.replit.dev"
# If unset, the API reflects any request origin (dev convenience only).
CORS_ORIGINS=""

# ==============================================================================
# FRONTEND (Vite public vars)
# ==============================================================================

# Base URL for the API server — used by the React frontend.
# Must start with VITE_ to be exposed to the browser.
VITE_API_BASE_URL="/api"

# ==============================================================================
# FUTURE (not yet implemented)
# ==============================================================================

# TODO (future phase): Video call provider credentials
# DAILY_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

