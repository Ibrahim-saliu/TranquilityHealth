# .env.example — Environment variable template for Tranquility Health.
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
#
# HIPAA NOTE: This file must never contain real credentials, PHI, or secrets.
#   All sensitive values must be provided via environment variables only.

# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In Replit, this is automatically provided when a database is provisioned.
DATABASE_URL="postgresql://user:password@localhost:5432/tranquility_health"

# ==============================================================================
# APPLICATION
# ==============================================================================

# Node environment. Use "development" locally, "production" in deployment.
NODE_ENV="development"

# The port the API server listens on.
# In Replit, PORT is automatically assigned.
PORT="3001"

# ==============================================================================
# AUTH
# ==============================================================================

# Session secret — signs the session cookie. REQUIRED in production; the API
# server refuses to start without it when NODE_ENV=production. Generate a strong
# random value, e.g. `openssl rand -base64 64`.
SESSION_SECRET=""

# --- Cross-origin escape hatches (normally leave these at defaults) ------------
# The app is designed to be SAME-ORIGIN: the browser calls "/api" relatively, and
# both dev (Vite proxy, see API_PROXY_TARGET) and prod (Replit application router)
# route "/api" to the API service under one domain. With that, the defaults below
# are correct and no cross-site cookie handling is needed.
#
# Only change these if you deliberately serve the SPA and API on DIFFERENT origins:
#   SESSION_COOKIE_SAMESITE=none  — let the cookie cross sites (also forces Secure)
#   CORS_ORIGINS=https://your-app-origin  — allowlist that exact origin
# Values for SameSite: lax | strict | none
SESSION_COOKIE_SAMESITE="lax"
CORS_ORIGINS=""

# ==============================================================================
# FRONTEND (Vite public vars)
# ==============================================================================

# Base URL the React frontend uses to reach the API. Keep this as the relative
# "/api" so requests stay SAME-ORIGIN as the page — do NOT point it at the API's
# absolute URL, or the session cookie will be dropped as cross-site.
VITE_API_BASE_URL="/api"

# Where the Vite dev/preview server proxies "/api" to — the API service's local
# port. Only needed in dev; production uses Replit's application router instead.
API_PROXY_TARGET="http://localhost:8080"

# ==============================================================================
# FUTURE (not yet implemented)
# ==============================================================================

