# .env.example — Environment variable template for Tranquility Health.
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
#
# HIPAA NOTE: This file must never contain real credentials, PHI, or secrets.
#   All sensitive values must be provided via environment variables only.

# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In Replit, this is automatically provided when a database is provisioned.
DATABASE_URL="postgresql://user:password@localhost:5432/tranquility_health"

# ==============================================================================
# APPLICATION
# ==============================================================================

# Node environment. Use "development" locally, "production" in deployment.
NODE_ENV="development"

# The port the API server listens on.
# In Replit, PORT is automatically assigned.
PORT="3001"

# ==============================================================================
# AUTH (Phase 3 — not yet implemented)
# ==============================================================================

# TODO (Phase 3): Add auth provider credentials here.
# Example for Replit Auth / OpenID Connect:
# REPL_IDENTITY_KEY=""
# REPLIT_AUTH_CLIENT_ID=""
# REPLIT_AUTH_CLIENT_SECRET=""

# Session secret — used to sign session cookies.
# TODO (Phase 3): Generate a strong random value (e.g., openssl rand -base64 64)
# SESSION_SECRET=""

# ==============================================================================
# FRONTEND (Vite public vars)
# ==============================================================================

# Base URL for the API server — used by the React frontend.
# Must start with VITE_ to be exposed to the browser.
VITE_API_BASE_URL="/api"

# ==============================================================================
# FUTURE (not yet implemented)
# ==============================================================================

# TODO (future phase): Video call provider credentials
# DAILY_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# TODO (future phase): Email provider credentials
# SENDGRID_API_KEY=""
# FROM_EMAIL="noreply@tranquilityhealth.com"
