// Tranquility Health — Prisma schema (Phase 0).
// PHI fields are marked with // PHI: for HIPAA compliance tracking.
// Connection URL is in prisma.config.ts (Prisma 7+). See .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  patient
  provider
  admin
}

enum AppointmentStatus {
  requested  // Patient submitted intake
  scheduled  // Admin confirmed, provider assigned
  completed
  cancelled
  noShow
}

// ── Models ─────────────────────────────────────────────────────────────────

// TODO (Phase 3): Add password hash or OAuth provider fields.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String   @unique // PHI: used for login and communications
  role      UserRole @default(patient)

  patient   Patient?
  provider  Provider?
  auditLogs AuditLog[] @relation("AuditLogUser")

  @@map("users")
}

// TODO (Phase 3): Add insurance, emergency contact fields. Encrypt PHI at rest.
model Patient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String    // PHI
  lastName    String    // PHI
  dateOfBirth DateTime? // PHI
  phone       String?   // PHI
  address     String?   // PHI

  onboardingComplete Boolean @default(false)

  appointmentRequests AppointmentRequest[]
  appointments        Appointment[]
  consentRecords      ConsentRecord[]

  @@map("patients")
}

// TODO (Phase 3): Add availability/schedule model, licensure verification.
model Provider {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName     String  // PHI
  lastName      String  // PHI
  specialty     String?
  licenseNumber String? // Sensitive — never log raw
  isActive      Boolean @default(true)

  appointments Appointment[]

  @@map("providers")
}

// TODO (Phase 3): Trigger admin notification on creation.
model AppointmentRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  reasonForVisit    String? // PHI
  insuranceName     String? // PHI
  insuranceMemberId String? // PHI

  status    String   @default("pending") // pending | reviewed | converted | declined
  reviewedAt DateTime?
  reviewedByAdminId String?
  convertedToAppointmentId String?

  @@map("appointment_requests")
}

// TODO (Phase 3): Generate video room token on creation, send confirmation email.
model Appointment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int               @default(50)
  status          AppointmentStatus @default(requested)

  videoRoomToken String? // Phase TBD
  sessionNotes   String? // PHI — never return in public API responses

  @@map("appointments")
}

// TODO (Phase compliance): Store consent document version and hash.
model ConsentRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consentType     String // e.g. HIPAA_NOTICE, TELEHEALTH_CONSENT
  signatureMethod String @default("electronic_checkbox") // PHI: signing method
  ipAddress       String? // PHI: retained for legal purposes
  signedAt        DateTime @default(now())
  documentVersion String?

  @@map("consent_records")
}

// Immutable audit log. Never update or delete records. HIPAA requires 6-year retention.
// TODO (Phase 3): Wire logAuditEvent() to write here.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  user      User?   @relation("AuditLogUser", fields: [userId], references: [id])

  action    String
  metadata  Json?   // PHI: may contain PHI if included in context
  ipAddress String?
  requestId String?

  @@map("audit_logs")
}
